<mvc:View
    controllerName="deltalight.com.mybankdetails.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    class="sapUiSizeCompact"
>
    <App id="app">
        <Page
            id="page"
            title="{i18n>HeaderTitle}"
        >
            <headerContent>
                <Button
                    id="demoBtn"
                    type="Emphasized"
                    text="{i18n>home}"
                />
            </headerContent>

            <content>
                <!-- Bank Detail Fragment -->
                <core:Fragment
                    id="bankDetailsFragment"
                    fragmentName="deltalight.com.mybankdetails.view.fragments.BankDetails"
                    type="XML"
                />

                <!-- Card Detail Fragment -->
                <core:Fragment
                    id="cardDetailsFragment"
                    fragmentName="deltalight.com.mybankdetails.view.fragments.CardDetails"
                    type="XML"
                />
            </content>
        </Page>
    </App>
</mvc:View>
